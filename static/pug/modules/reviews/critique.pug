include critique-data

section.reviews
    .container
        h2.reviews__title.section__title Рецензии
        ul.reviews__list
            li.reviews__item
                .reviews__wrapper
                    .reviews__info
                        .reviews__box-images
                            img.reviews__img(
                                src= critique[0].img
                                alt= critique[0].alt
                                width= critique[0].width
                                height= critique[0].height
                            )
                        .reviews__box
                            h3.reviews__name= critique[0].name
                            p.reviews__count= critique[0].count
                    p.reviews__review= critique[0].review
