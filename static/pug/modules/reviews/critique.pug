include critique-data

section.reviews
    .container
        h2.reviews__title.section__title Рецензии
        ul.reviews__list
            each item in critique
                li.reviews__item
                    .reviews__wrapper
                        .reviews__info
                            .reviews__box-images
                                img.reviews__img(
                                    src= item.img
                                    alt= item.alt
                                    width= item.width
                                    height= item.height
                                )
                            .reviews__box
                                h3.reviews__name= item.name
                                p.reviews__count= item.count
                        p.reviews__review= item.review