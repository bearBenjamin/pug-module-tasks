include reviews-data

section.reviews
    .container
        h2.reviews__title.section__title Отзывы
        ul.reviews__list
            each item in reviews
                li.reviews__item
                    .reviews__wrapper
                        .reviews__info
                            .reviews__box-images
                                img.reviews__img(
                                    src=item.img
                                    alt='Фото автора отзыва'
                                    width=item.width
                                    height=item.height
                                )
                            .reviews__box
                                h3.reviews__name= item.name
                                p.reviews__count= item.count
                        p.reviews__review= item.review