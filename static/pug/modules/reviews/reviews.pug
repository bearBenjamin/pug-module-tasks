include reviews-data

section.reviews
    .container
        h2.reviews__title.section__title Отзывы
        ul.reviews__list
            li.reviews__item
                .reviews__wrapper
                    .reviews__info
                        .reviews__box-images
                            img.reviews__img(
                                src=reviews[0].img
                                alt='Фото автора отзыва'
                                width=reviews[0].width
                                height=reviews[0].height
                            )
                        .reviews__box
                            h3.reviews__name= reviews[0].name
                            p.reviews__count= reviews[0].count
                    p.reviews__review= reviews[0].review
            li.reviews__item 
                .reviews__wrapper
